CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
# Persist ESP-IDF Core Dumps and the bounded ESP-Iris pre-crash log ring in
# the retained coredump partition after a panic.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_APP_RETRIEVE_LEN_ELF_SHA=64
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# USB High-Speed is owned by ESP-Iris. Device installation and logs go through
# the workspace's mosaico.py commands. Keep the console on UART and avoid the
# built-in USB Serial/JTAG controller.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_IRIS_TRANSPORT_USB=y
CONFIG_ESP_IRIS_TRANSPORT_TCP=y
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_TCP_PAIRING=y
CONFIG_ESP_IRIS_TCP_DEFER_UNTIL_NETIF=y
CONFIG_ESP_IRIS_USB_TASK_STACK_SIZE=2048
CONFIG_ESP_IRIS_SERVICE_STACK_SIZE=4096
CONFIG_ESP_IRIS_SERVICE_PERSISTENT=y
CONFIG_ESP_IRIS_SERVICE_CONTEXT_PSRAM=y
CONFIG_ESP_IRIS_SERVICE_STATE_PSRAM=y
CONFIG_ESP_IRIS_RPC_RESPONSE_PSRAM=y
CONFIG_ESP_IRIS_WIRE_BUFFERS_PSRAM=y
CONFIG_ESP_IRIS_LOG_RING_BYTES=16384
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Mirror chunks are copied into ESP-Iris's wire frame before USB DMA.
CONFIG_ESP_IRIS_MEDIA_BUFFER_PSRAM=y
# ESP-Iris assembles a wire frame in its own 4096-byte buffer. CDC can feed
# and drain it in chunks; keep RX >= endpoint capacity.
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024

# ESP-Mosaico 480x480 CO5300 QSPI display. GSP presents through
# esp_display_present; the BSP still pulls LVGL as a dependency.
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MEMTEST=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=20480
CONFIG_ESP_TASK_WDT_INIT=n

CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="1.1.0"

CONFIG_TINYUSB_CDC_COUNT=2

# ---- Glimdock + Home (native LVGL through the BSP adapter, not GSP) ----
CONFIG_BSP_DISPLAY_LVGL_ENABLE=y
# Glimdock styles every widget itself; the default theme would restyle them.
# CONFIG_LV_USE_THEME_DEFAULT is not set
CONFIG_LV_USE_TINY_TTF=y
# Glass edges and fills use up to four gradient stops.
CONFIG_LV_GRADIENT_MAX_STOPS=4
CONFIG_LV_USE_SNAPSHOT=y
# Built-in Montserrat sizes carry LV_SYMBOL_* glyphs as TTF fallbacks.
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
# Collector, agents, private reader, setup portal, captive DNS, hub, ESP-Iris.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# The VPN's WireGuard interface is a plain lwIP netif that keeps its own state
# in netif->state. ESP-NETIF must then keep its pointer in the netif's client
# data instead, which ESP-IDF does when bridge support is built in (no bridge
# is ever made). Without it, adding the tunnel crashed lwIP's thread in
# ESP-NETIF's address callback.
CONFIG_ESP_NETIF_BRIDGE_EN=y
# The template bootloader (never installed; the board keeps its retained one)
# must still fit before 0x8000 for the build's size check.
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
# Keep internal RAM for ESP-Iris, Wi-Fi, TLS and DMA: malloc() always tries
# PSRAM first. At 512, the apps' small strings and lists (40-120 bytes each)
# filled internal RAM as they opened, until the speech connection's TLS and the
# display's transfers failed and the board slowed down. Code that needs
# internal or DMA memory asks for it (heap_caps_malloc).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# TLS buffers in PSRAM: two apps keep sessions open, and the display needs
# internal DMA memory for every SPI transfer.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# A failed LVGL assertion traps with a backtrace (config/lvgl_assert_trap.h).
CONFIG_LV_ASSERT_HANDLER_INCLUDE="lvgl_assert_trap.h"
# Camera sub-board (left slot). GPIO33 is camera D2 and shares the USB
# Serial/JTAG D- pad, so that peripheral stays off (ESP-Iris uses USB HS OTG).
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_MOSAICO_MODULE_CAMERA=y
CONFIG_CAMERA_OV3640=y
CONFIG_CAMERA_OV3640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV3640_DVP_YUV422_UYVY_1024X768_25FPS=y
CONFIG_CAMERA_OV3640_DVP_DEFAULT_FMT_YUV422_UYVY_1024X768_25FPS=y
CONFIG_CAMERA_SC101IOT=y
CONFIG_CAMERA_SC101IOT_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC101IOT_DVP_YUV422_1280X720_25FPS=y
CONFIG_CAMERA_SC101IOT_DVP_DEFAULT_FMT_YUV422_1280X720_25FPS=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
# Glimdock serial, boot stage, orientation, perf, camera, apps, config, Swifty, NAS + OTA: past 16 the newest silently failed to register.
CONFIG_ESP_IRIS_MAX_RPC_HANDLERS=32

# Scrolling: up to 60 fps, and render on both cores (two software draw units).
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# Per-task CPU time, for the frame profiler (perf.cpp, service 0x4744 methods 13/14).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Files and photos on the NAND: LittleFS over the NAND block device (esp_blockdev).
CONFIG_NAND_FLASH_ENABLE_BDL=y
# Software AES for TLS: the hardware AES (DMA) needs internal DMA memory for
# every record and failed to get it under load ("esp-aes: Failed to allocate
# memory", MBEDTLS_ERR_SSL_HW_ACCEL_FAILED): speech and HTTPS connections
# dropped at random. The traffic is small; SHA, MPI and ECC stay in hardware.
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# A 1 ms tick: at 100 Hz any wait under 10 ms rounds to 0 ticks and spins.
# The LVGL adapter sleeps "until the next timer" (often a few ms), so it span
# at priority 6, taking ~45 % of a core and starving whatever shared it.
CONFIG_FREERTOS_HZ=1000
